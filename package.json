{
  "name": "video-downloader",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "视频下载工具：YouTube / 抖音 / 哔哩哔哩 / 小红书 —— Electron + React + Ant Design",
  "author": "SillyShalong",
  "license": "MIT",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "gui": "node gui.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build:web": "vite build",
    "dist": "npm run build:web --silent && electron-builder --win",
    "test": "npm run build:web --silent && node --test tests/",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "test:gui": "node --test tests/gui.test.mjs",
    "test:network": "RUN_NETWORK_TESTS=1 node --test tests/",
    "dist:win": "npm run build:web --silent && electron-builder --win",
    "dist:mac": "npm run build:web --silent && electron-builder --mac",
    "dist:linux": "npm run build:web --silent && electron-builder --linux"
  },
  "build": {
    "appId": "io.github.SillyShalong.video-downloader",
    "productName": "Video Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "web/dist/**/*",
      "cli.mjs",
      "gui.mjs",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Video Downloader",
      "artifactName": "VideoDownloader-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "VideoDownloader-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "antd": "^6.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1",
    "vite": "^8.3.8"
  }
}
